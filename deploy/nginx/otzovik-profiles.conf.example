# Hosting-neutral Отзыв.com static profile vhost.
# Replace the root path and TLS directives for the target server/provider.

map $host $otzovik_slug {
    hostnames;
    default "";
    ~^(?<company>[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)\.xn--b1ajuq0c\.com$ $company;
}

server {
    listen 80;
    server_name *.xn--b1ajuq0c.com;

    # TLS/HTTPS is intentionally provider-specific and not defined here.

    if ($otzovik_slug = "") { return 404; }

    root /srv/otzovik-public-profiles/profiles;

    location / {
        # Each hostname is confined to its own generated slug directory.
        try_files /$otzovik_slug$uri /$otzovik_slug$uri/ =404;
    }

    location = / {
        try_files /$otzovik_slug/index.html =404;
    }

    location ~ /\. {
        return 404;
    }

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
}
